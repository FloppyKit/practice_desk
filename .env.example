# Copy to .env. Never commit a filled copy.
# SMS bridge: off until secrets/spruce.env is filled (gitignored).
# spruce_api sends through the Spruce API. spruce_mac was the clicker fallback.
# SMS_BRIDGE=
# Website chat inbox. 1 = push an internal Spruce note and pull staff replies.
# Does not turn reminder texts on. Webhook secret is created when the endpoint is registered.
# SPRUCE_INBOX_API=
# SPRUCE_WEBHOOK_SECRET=
# SMS_BRIDGE_SECRET=
# Unlock field / X-Staff-Secret / cookie dmb-desk.
REMIND_CRON_SECRET=
STAFF_SECRET=

# calendar: google | caldav | demo
CALENDAR_BACKEND=demo
BOOKER_CONFIG=/app/config/event-types.example.yaml
PRACTICE_DIR=/data/logs/practice

PORT=8090

# CIPHER_P1 — sealed-intake demo pipe (synthetic data only; clinical_claim false).
# Default 0: legacy cleartext booking path unchanged.
#CIPHER_P1=0
# When on: also write the cleartext sqlite client shadow (default 1).
#CIPHER_DUAL_WRITE=1
# When on: new calendar events are occupancy-only, no patient_* props (default 1).
#CIPHER_OCCUPANCY=1
#CIPHER_QUEUE_DB=/data/logs/cipher_queue.sqlite
#CIPHER_SEAL_KEY_FILE=/data/logs/cipher-seal-v1.json

# Edge-scribe → desk blank-note ingest (header X-Scribe-Ingest-Token)
SCRIBE_INGEST_TOKEN=
#SCRIBE_DRAFTS_DB=/data/logs/scribe_drafts.sqlite
