# Thin pipe. Models live behind a URL — not on this box.
# SCRIBE_BACKEND=openrouter | http
SCRIBE_BACKEND=openrouter
OPENROUTER_API_KEY=
OPENROUTER_STT_MODEL=openai/gpt-4o-mini-transcribe
OPENROUTER_NOTE_MODEL=google/gemini-2.5-flash

# BYO (used when SCRIBE_BACKEND=http, or to override OR)
# SCRIBE_STT_URL=https://your-box/transcribe
# SCRIBE_STT_TOKEN=
# SCRIBE_NOTE_URL=https://your-box/note
# SCRIBE_NOTE_TOKEN=

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=office

NOTIFY_WEBHOOK_URL=http://127.0.0.1:8791/notify
NOTIFY_WEBHOOK_TOKEN=
SCRIBE_TO=matt@drmattbrown.com
SCRIBE_BIND=127.0.0.1
SCRIBE_PORT=8793
