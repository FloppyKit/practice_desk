# scribe-aws sidecar (127.0.0.1:8795). chmod 600. Never commit the real file.
AWS_REGION=us-east-1
# IAM principal under the BAA account needs ONLY:
#   transcribe:StartMedicalStreamTranscription  (HTTP/2 streaming; no S3, no batch jobs)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_MEDICAL_SPECIALTY=PRIMARYCARE
AWS_STREAM_PACE=2.0
# 1 = skip AWS, always use whisper (instant flip-back without touching scribe)
SCRIBE_AWS_DISABLE=
WHISPER_URL=http://127.0.0.1:8794
# Note polish: Bedrock (BAA). Same Bedrock API key mechanism as site/.env (only these values copied).
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
STYLE_PACK_DIR=/style-pack
# booker /api/desk/note/draft uses xAI ("not a BAA path"); off unless you opt in.
DESK_DRAFT_ALLOW_NONBAA=
DESK_DRAFT_URL=http://127.0.0.1:8090/api/desk/note/draft
DESK_STAFF_SECRET=
