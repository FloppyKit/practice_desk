[Unit]
Description=Psych Arts proton-notify (Drive/Mail bridge for booker) on 127.0.0.1:8791
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root
Environment=HOME=/home/deploy
Environment=PATH=/home/deploy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/python3 /home/deploy/edge/scripts/proton-notify-server.py
StandardOutput=append:/root/edge/logs/proton-notify.log
StandardError=append:/root/edge/logs/proton-notify.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
